{
  "name": "draftline-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",

  // LIMITS: rate-limit counters and the running daily spend total. Both are
  // short-lived keys with a TTL; nothing in it is worth backing up.
  //
  // USERS: accounts, sessions and each account's saved draft. This one *is* the
  // durable data, which is exactly why it is a separate namespace — clearing the
  // counters is a thing someone might reasonably do, and it must not be able to
  // take the accounts with it.
  "kv_namespaces": [
    { "binding": "LIMITS", "id": "91114a0eb08343b08ea5a2a63a194006" },
    { "binding": "USERS",  "id": "80309e59b0a0495caa5dc0f40693232e" }
  ],

  // ANTHROPIC_API_KEY is a secret, not a var — set it with
  //   npx wrangler secret put ANTHROPIC_API_KEY
  // and it never enters this file or the repo.

  "observability": { "enabled": true }
}
