# Build / tooling caches — never commit
.wrangler/
__pycache__/
*.pyc

# Agent scratch and local session config — machine-local, not shared state
.buildtmp/
.claude/

# Local Worker secrets for `wrangler dev` — real values, never commit
.dev.vars

# Yahoo probe: real credentials and cached OAuth tokens — never commit
ff/tools/.yahoo-creds.json
ff/tools/.yahoo-token.json
